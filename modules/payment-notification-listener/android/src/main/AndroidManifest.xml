<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <!-- Android 13+: lets the app show the ongoing "listening for payments"
       notification its foreground service needs. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <!-- Asks to be exempt from battery optimisation, so announcements keep
       arriving while the phone sits idle. -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

  <!-- Needed on Android 11+ to check whether an OEM autostart screen exists. -->
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
    </intent>
  </queries>

  <application>

    <!-- Reads payment notifications from other apps. Requires the user to grant
         "Notification access" manually in system settings — this cannot be
         requested via a normal runtime permission prompt. -->
    <service
      android:name=".PaymentListenerService"
      android:label="Universal Speaker"
      android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
      android:exported="true">
      <intent-filter>
        <action android:name="android.service.notification.NotificationListenerService" />
      </intent-filter>
    </service>

    <!-- Foreground service that keeps the ESP32 connection alive and relays
         parsed payment events to it while the app is backgrounded. -->
    <service
      android:name=".PaymentBridgeService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />

  </application>
</manifest>
